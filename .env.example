# Krishi Mithram — Environment Variables Template
# Copy this file to .env and fill in your actual API keys.
# NEVER commit the .env file — it is gitignored.

# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# AI Providers — the app tries each in order: Groq → OpenRouter → OpenAI
# At least one is required for the AI Assistant and Disease Doctor.
VITE_GROQ_API_KEY=your_groq_api_key          # https://console.groq.com
VITE_OPENROUTER_API_KEY=your_openrouter_key  # https://openrouter.ai/keys
VITE_OPENAI_API_KEY=your_openai_api_key      # https://platform.openai.com/api-keys

# Gemini (optional — add a valid AIza... key from https://aistudio.google.com/app/apikey)
# VITE_GEMINI_API_KEY=AIzaSy...

# Market Prices — data.gov.in Mandi API (optional)
VITE_MANDI_API_KEY=your_mandi_api_key        # https://data.gov.in/user/register

# Weather — Open-Meteo is free and needs no key (default below)
VITE_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Plant Disease Detection — Pl@ntNet (optional)
VITE_PLANTNET_API_KEY=your_plantnet_api_key  # https://my-api.plantnet.org

# Geolocation — IPStack (optional, for IP-based fallback location)
VITE_IPSTACK_API_KEY=your_ipstack_key        # https://ipstack.com
